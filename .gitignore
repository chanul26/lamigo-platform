# ============================================
# LamiGo Platform - Master .gitignore
# Multi-stack: Flutter, FastAPI, Next.js
# ============================================

# ============================================
# OS & IDE Files
# ============================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
.vscode/

# JetBrains IDEs (IntelliJ, Android Studio, PyCharm)
.idea/
*.iml
*.ipr
*.iws

# VS Code (uncomment if you don't want to share settings)
# .vscode/

# Cursor AI
.cursorignore
.cursorindexingignore

# Google Project IDX / Antigravity
.agents/

# ============================================
# Environment Variables (NEVER COMMIT)
# ============================================
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# ============================================
# Python / FastAPI (backend/)
# ============================================
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments
.venv/
venv/
ENV/
env/
.Python

# Distribution / packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Testing & Coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
.hypothesis/

# Database files
*.db
*.sqlite
*.sqlite3
db.sqlite3

# Type checkers
.mypy_cache/
.dmypy.json
.pytype/
.pyre/

# Logs
*.log
pip-log.txt

# ============================================
# Node.js / Next.js (web-portals/)
# ============================================
node_modules/
.next/
out/
.vercel/
.turbo/

# Package manager logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Build outputs
*.tsbuildinfo

# ============================================
# Flutter / Dart (mobile-app/)
# ============================================
# IMPORTANT: lib/ folder is SOURCE CODE - do NOT ignore it!
# !mobile-app/lib/  # This is explicitly NOT ignored

# Build outputs
**/build/
mobile-app/build/

# Dart/Flutter tools
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/

# Generated files
*.g.dart
*.freezed.dart
*.mocks.dart

# Coverage
coverage/

# Symbolication & Obfuscation
app.*.symbols
app.*.map.json

# Android specific
mobile-app/android/.gradle/
mobile-app/android/app/debug/
mobile-app/android/app/profile/
mobile-app/android/app/release/
mobile-app/android/local.properties
*.jks
*.keystore

# iOS specific (when added)
mobile-app/ios/Pods/
mobile-app/ios/.symlinks/
mobile-app/ios/Flutter/Flutter.framework
mobile-app/ios/Flutter/Flutter.podspec
mobile-app/ios/Flutter/Generated.xcconfig
mobile-app/ios/Flutter/app.flx
mobile-app/ios/Flutter/engine/
mobile-app/ios/ServiceDefinitions.json
**/ios/Flutter/.last_build_id

# macOS specific (when added)
mobile-app/macos/Flutter/GeneratedPluginRegistrant.swift
mobile-app/macos/Flutter/ephemeral/

# ============================================
# Temporary & Misc Files
# ============================================
*.tmp
*.temp
*.swp
*.swo
*~
.cache/
tmp/
temp/

# ============================================
# Documentation builds
# ============================================
docs/_build/
site/

# ============================================
# backend/config/ - Configuration files (if any, otherwise ignore this section)
# ============================================
config/*.json