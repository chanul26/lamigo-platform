# ============================================
# LamiGo Mobile App - Flutter .gitignore
# ============================================

# IMPORTANT: The lib/ folder contains SOURCE CODE
# It is explicitly NOT ignored and MUST be committed!

# ============================================
# Miscellaneous
# ============================================
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.history
.svn/
migrate_working_dir/

# ============================================
# IntelliJ / Android Studio
# ============================================
*.iml
*.ipr
*.iws
.idea/

# ============================================
# VS Code (optional - comment out if sharing settings)
# ============================================
# .vscode/

# ============================================
# Flutter / Dart / Pub
# ============================================
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
pubspec.lock  # Comment out if you want to lock versions

# Build outputs
/build/
**/build/

# Coverage
/coverage/

# Generated documentation
**/doc/api/
**/ios/Flutter/.last_build_id

# ============================================
# Generated Code (if using code generation)
# ============================================
*.g.dart
*.freezed.dart
*.mocks.dart
*.config.dart

# ============================================
# Symbolication & Obfuscation
# ============================================
app.*.symbols
app.*.map.json

# ============================================
# Android
# ============================================
/android/.gradle/
/android/app/debug/
/android/app/profile/
/android/app/release/
/android/local.properties
*.jks
*.keystore
!app/debug.keystore

# Gradle
.gradle/
**/android/**/gradle-wrapper.jar

# ============================================
# iOS (when added)
# ============================================
/ios/Pods/
/ios/.symlinks/
/ios/Flutter/Flutter.framework
/ios/Flutter/Flutter.podspec
/ios/Flutter/Generated.xcconfig
/ios/Flutter/app.flx
/ios/Flutter/engine/
/ios/ServiceDefinitions.json
/ios/Runner/GeneratedPluginRegistrant.*
**/ios/Flutter/ephemeral/
**/ios/Flutter/.last_build_id

# ============================================
# macOS (when added)
# ============================================
/macos/Flutter/GeneratedPluginRegistrant.swift
/macos/Flutter/ephemeral/
**/macos/Flutter/ephemeral/

# ============================================
# Web (when added)
# ============================================
/web/favicon.png
