# LamiGo Backend – copy to .env and fill in values. Do not commit .env.

# Database (required for multi-tenant bootstrap)
DATABASE_URL=postgresql://user:password@localhost:5432/lamigo

# Firebase service account JSON path (required for bootstrap_admin.py)
# Place the file at backend/config/serviceAccountKey.json
FIREBASE_SERVICE_ACCOUNT_PATH=config/serviceAccountKey.json
