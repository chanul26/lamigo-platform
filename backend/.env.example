# LamiGo Backend Configuration
# Copy this file to .env and fill in your values. Do not commit .env.

# Application
APP_NAME=LamiGo API
APP_VERSION=1.0.0
DEBUG=false

# Database (required for multi-tenant bootstrap)
DATABASE_URL=postgresql://user:password@localhost:5432/lamigo

# Firebase service account JSON path (required for bootstrap_admin.py)
# Place the file at backend/credentials/serviceAccountKey.json
FIREBASE_SERVICE_ACCOUNT_PATH=credentials/serviceAccountKey.json

# CORS Origins (comma-separated for multiple origins)
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001","http://127.0.0.1:3000","http://127.0.0.1:3001"]

# JWT Settings (for future use)
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
