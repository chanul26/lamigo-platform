# ============================================
# LamiGo Backend .gitignore
# ============================================

# Environment & Secrets (CRITICAL)
.env
.env.*
*.env.local

# Firebase & Master Credentials
credentials/*
!credentials/.gitkeep
config/*.json

# OS Junk
.DS_Store

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
ENV/
env/
.venv/

# IDE
.idea/
.vscode/
*.swp
*.swo

# Testing
.pytest_cache/
.coverage
htmlcov/

# Alembic Migrations
alembic/versions/*.pyc